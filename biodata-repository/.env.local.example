# Copy this file to .env.local and fill in your Supabase project's values.
# Find these in your Supabase project: Settings -> API.

# Project URL (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "public" key (safe to expose in the browser — read-only via RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key (SECRET — server-side only, never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=
